{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "_meta": {
    "name": "team_package_schema",
    "version": "3.4.1",
    "updated": "2026-10-25",
    "usage": "9 名数字员工之间的标准化数据契约。每个 SKILL 输出的团队作战包必须通过本 schema 校验（scripts/validate_package.py）。Signal 卡设计对标 virattt/ai-hedge-fund v2：观点与仓位分离、必附 reasoning、支持弃权。",
    "note": "v3.3.0 修正：schema_version 由单一常量改为枚举白名单（旧版只认 3.2.0）。v3.3.1 再修正：校验器不再依赖白名单硬判，凡 X.Y.Z 语义化版本一律放行，仅对新旧差异出 warn，避免团队升版时圆桌收包再次断裂。"
  },
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "timestamp",
    "subject",
    "signal",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "3.2.0",
        "3.2.1",
        "3.2.2",
        "3.2.3",
        "3.3.0",
        "3.3.1",
        "3.3.2",
        "3.4.0",
        "3.4.1"
      ],
      "default": "3.4.1"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^fin-ai-[a-z]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "description": "分析对象：单股或组合",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "stock",
            "portfolio",
            "event"
          ]
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "market": {
          "enum": [
            "cn",
            "hk",
            "us",
            "mixed"
          ]
        }
      }
    },
    "signal": {
      "type": "object",
      "required": [
        "value",
        "confidence",
        "reasoning"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "观点方向与强度：+1 最强看多，-1 最强看空"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasoning": {
          "type": "string",
          "minLength": 20,
          "description": "人类可读论据，禁止空泛"
        },
        "abstain": {
          "type": "boolean",
          "default": false,
          "description": "数据不足时弃权，不参与共识计算"
        },
        "abstain_reason": {
          "type": "string"
        },
        "recommendation": {
          "enum": [
            "buy",
            "add",
            "hold",
            "reduce",
            "sell",
            "avoid",
            "partial_reduce",
            null
          ]
        },
        "key_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "description": "各 skill 专属明细（估值区间/风险清单/调仓建议/执行计划等），自由结构"
    },
    "real_data_refs": {
      "type": "array",
      "description": "引用的数据层端点调用记录（含 source/status），供数据一致性核对",
      "items": {
        "type": "string"
      }
    },
    "audit": {
      "type": "object",
      "required": [
        "input_snapshot_hash",
        "data_as_of"
      ],
      "properties": {
        "input_snapshot_hash": {
          "type": "string",
          "description": "输入数据快照 sha256，供审计回放"
        },
        "data_as_of": {
          "type": "string",
          "description": "数据时点，防前视偏差的关键字段"
        },
        "tokens_estimate": {
          "type": "integer"
        },
        "downgraded_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "version": "3.4.1"
}